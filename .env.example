# What If? AI Scenario Simulator - Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (required for AI-powered responses)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: AI Model to use (default: gpt-4o-mini)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
AI_MODEL=gpt-4o-mini

# Optional: Server port (default: 3000)
PORT=3000

# Optional: AI Temperature (0-2, default: 0.7)
# Higher = more creative, Lower = more focused
AI_TEMPERATURE=0.7

# Optional: Max tokens per response (default: 2000)
AI_MAX_TOKENS=2000